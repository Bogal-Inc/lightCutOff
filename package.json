{
    "name": "lightcutoff",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "config": "ts-node set-env.ts",
        "start": "node server.js",
        "start:dev": "npm run config -- && ng serve --aot",
        "build": "npm run config -- && ng build --aot",
        "build:heroku": "npm run config -- && ng build --aot --configuration=staging --prod",
        "test": "npm run config -- && ng test --code-coverage",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "postbuild": "npm run build:heroku"
    },
    "private": true,
    "dependencies": {
