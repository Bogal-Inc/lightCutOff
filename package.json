    "devDependencies": {
        "@angular-devkit/build-angular": "~0.1000.0-next.3",
        "@angular/cli": "~10.0.0-next.3",
        "@angular/compiler-cli": "~10.0.0-next.4",
        "@angular/language-service": "~10.0.0-next.4",
        "@types/googlemaps": "^3.39.6",
