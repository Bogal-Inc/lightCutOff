{
  "name": "lightcutoff",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "config": "ts-node set-env.ts",
    "clean": "rimraf ./dist",
    "start:dev": "npm run config -- && ng serve",
    "build": "npm run clean && npm run config -- && ng build --aot --source-map",
    "build:prod": "npm run clean && npm run config -- --environment=prod && ng build --configuration production --source-map=false --base-href .",
    "build:staging": "npm run clean && npm run config -- && ng build --configuration=staging --configuration production --source-map=false --base-href .",
    "test": "ng test --browsers=ChromeHeadless --code-coverage --watch=false",
    "test:ci": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@agm/core": "^1.1.0",
    "@angular/animations": "~12.1.0",
    "@angular/cdk": "^11.2.9",
    "@angular/common": "~12.1.0",
    "@angular/compiler": "~12.1.0",
    "@angular/core": "~12.1.0",
    "@angular/fire": "^6.1.5",
    "@angular/forms": "~12.1.0",
    "@angular/google-maps": "^11.2.9",
    "@angular/localize": "~12.1.0",
    "@angular/platform-browser": "~12.1.0",
    "@angular/platform-browser-dynamic": "~12.1.0",
    "@angular/router": "~12.1.0",
    "@angular/service-worker": "~12.1.0",
    "@fortawesome/angular-fontawesome": "^0.8.2",
    "@fortawesome/fontawesome-svg-core": "^1.2.35",
    "@fortawesome/free-solid-svg-icons": "^5.15.3",
    "@ng-bootstrap/ng-bootstrap": "^9.1.0",
    "@ngx-translate/core": "^13.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "@types/chart.js": "^2.9.32",
    "ag-grid-angular": "^25.3.0",
    "ag-grid-community": "^25.3.0",
    "angular2-chartjs": "^0.5.1",
    "angularfire2": "^5.4.2",
    "bootstrap": "^4.6.0",
    "colors": "^1.4.0",
    "cookieconsent": "^3.1.1",
    "dotenv": "^8.2.0",
    "firebase": "^8.4.1",
    "firebase-functions": "^3.13.2",
    "firebase-tools": "^9.10.0",
    "firebaseui": "^4.8.0",
    "jquery": "^3.6.0",
    "karma-chrome-launcher": "^3.1.0",
    "messageformat": "^2.3.0",
    "ng-pick-datetime": "^7.0.0",
    "ngx-bootstrap": "^6.2.0",
    "ngx-cookieconsent": "^2.2.3",
    "ngx-toastr": "^13.2.1",
    "ngx-translate-messageformat-compiler": "^4.9.0",
    "rxjs": "~6.6.7",
    "tslib": "^2.2.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.1.0",
    "@angular-eslint/builder": "4.0.0",
    "@angular-eslint/eslint-plugin": "4.0.0",
    "@angular-eslint/eslint-plugin-template": "4.0.0",
    "@angular-eslint/schematics": "4.0.0",
    "@angular-eslint/template-parser": "4.0.0",
    "@angular/cli": "^12.1.0",
    "@angular/compiler-cli": "~12.1.0",
    "@angular/language-service": "~12.1.0",
    "@types/googlemaps": "^3.43.3",
    "@types/jasmine": "^3.6.9",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^14.14.41",
    "@typescript-eslint/eslint-plugin": "4.16.1",
    "@typescript-eslint/parser": "4.16.1",
    "eslint": "^7.6.0",
    "jasmine-core": "^3.7.1",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.3.2",
    "karma-coverage": "^2.0.3",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~3.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "protractor": "~7.0.0",
    "ts-node": "^9.1.1",
    "typescript": "~4.2.4",
    "yargs": "^16.2.0"
  },
  "engines": {
    "node": "14.16.0",
    "npm": "7.8.0"
  }
}
