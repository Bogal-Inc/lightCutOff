{
  "name": "lightcutoff",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "config": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' --transpileOnly set-env.ts",
    "clean": "rimraf ./dist",
    "start:dev": "npm run config -- && ng serve",
    "build": "npm run clean && npm run config -- && ng build --source-map",
    "build:prod": "npm run clean && npm run config -- --environment=prod && ng build --configuration production --source-map=false",
    "build:staging": "npm run clean && npm run config -- && ng build --configuration staging",
    "test": "ng test --browsers=ChromeHeadless --code-coverage --watch=false",
    "test:ci": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~20.0.0",
    "@angular/common": "~20.0.0",
    "@angular/compiler": "~20.0.0",
    "@angular/core": "~20.0.0",
    "@angular/fire": "~20.0.0",
    "@angular/forms": "~20.0.0",
    "@angular/localize": "~20.0.0",
    "@angular/platform-browser": "~20.0.0",
    "@angular/platform-browser-dynamic": "~20.0.0",
    "@angular/router": "~20.0.0",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@popperjs/core": "^2.11.8",
    "ag-grid-angular": "^34.0.0",
    "ag-grid-community": "^34.0.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.9",
    "firebase": "^11.8.0",
    "ngx-toastr": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.0.0",
    "@angular/build": "~20.0.0",
    "@angular/cli": "~20.0.0",
    "@angular/compiler-cli": "~20.0.0",
    "@angular/language-service": "~20.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "angular-eslint": "^20.0.0",
    "colors": "^1.4.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.20.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.20.0",
    "yargs": "^17.7.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}