{
  "name": "lightcutoff",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "config": "ts-node set-env.ts",
    "clean": "rimraf ./dist",
    "start:dev": "npm run config -- && ng serve --aot",
    "build": "npm run clean && npm run config -- && ng build --aot --source-map",
    "build:cordova": "npm run config -- && ng build --aot --prod --source-map=false --base-href . --output-path ../lightcutoffApp/www/",
    "build:prod": "npm run clean && npm run config -- && ng build --aot --prod --source-map=false --base-href .",
    "build:staging": "npm run clean && npm run config -- && ng build --aot --configuration=staging --prod --source-map=false --base-href .",
    "test": "ng test --browsers=ChromeHeadless --code-coverage --watch=false",
    "test:ci": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@agm/core": "^1.1.0",
    "@angular/animations": "~12.0.0-next.9",
    "@angular/cdk": "^11.2.9",
    "@angular/common": "~12.0.0-next.9",
    "@angular/compiler": "~12.0.0-next.9",
    "@angular/core": "~12.0.0-next.9",
    "@angular/fire": "^6.0.0",
    "@angular/forms": "~12.0.0-next.9",
    "@angular/google-maps": "^9.2.3",
    "@angular/localize": "~12.0.0-next.9",
    "@angular/platform-browser": "~12.0.0-next.9",
    "@angular/platform-browser-dynamic": "~12.0.0-next.9",
    "@angular/router": "~12.0.0-next.9",
    "@angular/service-worker": "~12.0.0-next.9",
    "@fortawesome/angular-fontawesome": "^0.7.0",
    "@fortawesome/fontawesome-svg-core": "^1.2.29",
    "@fortawesome/free-solid-svg-icons": "^5.13.1",
    "@ng-bootstrap/ng-bootstrap": "^6.1.0",
    "@ngx-translate/core": "^13.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "@types/chart.js": "^2.9.22",
    "ag-grid-angular": "^23.2.1",
    "ag-grid-community": "^23.2.1",
    "angular2-chartjs": "^0.5.1",
    "bootstrap": "^4.5.3",
    "colors": "^1.4.0",
    "cookieconsent": "^3.1.1",
    "dotenv": "^8.2.0",
    "firebase": "^7.24.0",
    "firebase-functions": "^3.11.0",
    "firebase-tools": "^8.14.1",
    "firebaseui": "^4.7.1",
    "jquery": "^3.5.1",
    "karma-chrome-launcher": "^3.1.0",
    "messageformat": "^2.3.0",
    "ng-pick-datetime": "^7.0.0",
    "ng2-validation": "^4.2.0",
    "ngx-bootstrap": "^5.6.1",
    "ngx-cookieconsent": "^2.2.3",
    "ngx-toastr": "^12.0.1",
    "ngx-translate-messageformat-compiler": "^4.7.0",
    "rxjs": "~6.5.4",
    "tslib": "^1.10.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1000.0-next.3",
    "@angular/cli": "~10.0.0-next.3",
    "@angular/compiler-cli": "~12.0.0-next.9",
    "@angular/language-service": "~12.0.0-next.9",
    "@types/googlemaps": "^3.39.6",
    "@types/jasmine": "^3.5.10",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.12.42",
    "codelyzer": "^6.0.0-next.1",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~5.0.0",
    "karma-coverage-istanbul-reporter": "~2.1.0",
    "karma-jasmine": "~3.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "protractor": "~5.4.3",
    "puppeteer": "^4.0.0",
    "ts-node": "^8.10.1",
    "tslint": "~6.1.0",
    "typescript": "~4.2.4"
  },
  "engines": {
    "node": "12.16.2",
    "npm": "6.14.4"
  }
}
